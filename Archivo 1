import java.util.Scanner;

public class Gauss {
    
    public static void eliminacionGaussiana(double[][] matriz, int n) {
        for (int i = 0; i < n; i++) {
            int pivote = i;
            for (int j = i + 1; j < n; j++) {
                if (Math.abs(matriz[j][i]) > Math.abs(matriz[pivote][i])) {
                    pivote = j;
                }
            }
            double[] temp = matriz[i];
            matriz[i] = matriz[pivote];
            matriz[pivote] = temp;
            
            for (int j = i + 1; j < n; j++) {
                double factor = matriz[j][i] / matriz[i][i];
                for (int k = i; k <= n; k++) {
                    matriz[j][k] -= factor * matriz[i][k];
                }
            }
        }
    }
}
